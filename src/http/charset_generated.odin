// CHARSET_ENTRIES is every name the registry resolves to a *text* codec,
// keyed by the normalized spelling (421 of them: several spell a codec the
// same way, so the tables above are shared).  A `Single_Byte` entry's
// `decode` maps a byte to its code point, CHARSET_UNDEFINED meaning the
// decoder refuses that byte (the undefined entries `errors='replace'` turns
// into U+FFFD); its encoder is the table inverted, last index wins, which is
// `codecs.charmap_build`.  `Other` is a text codec the port has no decoder
// for; `Utf8` and `Utf8_Sig` are the two the decoder implements as a utf-8
// walk.
//
// `strict` is the *strict* encoder of the same codec — `str.encode` with no
// `errors=`, which is what a printed head is written with — as the class
// src/http/charset.odin's `Charset_Strict_Class` names: the codec name and
// reason the reference's `UnicodeEncodeError` carries for the three classes
// whose failure set is the inverted table, and `None` for a codec whose
// encoder is not that table at all (the two named in the header above).
CHARSET_ENTRIES := []Charset_Entry{
	{name = "037", kind = .Single_Byte, decode = &DECODE_CP037, strict = .Charmap},
	{name = "1026", kind = .Single_Byte, decode = &DECODE_CP1026, strict = .Charmap},
