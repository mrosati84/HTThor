// CHARSET_NON_TEXT_NAMES are the resolved names that are not text codecs: a
// byte string decoded with one raises LookupError — "'<name>' is not a text
// encoding; use codecs.decode() to handle arbitrary codecs" — and `str.encode`
// the same with codecs.encode().  httpie's `--response-charset` refuses them
// at parse time for that reason.
CHARSET_NON_TEXT_NAMES := []string{
	"base64",
	"base64_codec",
	"base_64",
	"bz2",
	"bz2_codec",
	"hex",
	"hex_codec",
	"quopri",
	"quopri_codec",
	"quoted_printable",
	"quotedprintable",
	"rot13",
	"rot_13",
	"uu",
	"uu_codec",
	"zip",
	"zlib",
	"zlib_codec",
}

// CHARSET_RAISING_NAMES resolve and are not text codecs to a LookupError:
// their own codec raises (UnicodeError) when it is used, so httpie's
// `--response-charset` reports argparse's generic refusal instead —
// "invalid response_charset_type value" — and a declared charset prints the
// UnicodeError itself (docs/PARITY.md section 3.4 records the latter).
CHARSET_RAISING_NAMES := []string{
	"undefined",
}

// CHARSET_TABLE_HASH is FNV-1a 64 over the three tables above, in the order
// they are declared: for every entry its name, a NUL, its kind as one byte,
// its strict-encoder class as one byte and — for a `Single_Byte` entry — its
// 256 code points as four little-endian bytes each, then the two name lists
// behind 0x01 and 0x02.  tests/charset_test.odin recomputes it from the
// compiled tables, so a table that drifted, or a lookup that misses an
// entry, fails a unit test rather than one shape.
CHARSET_TABLE_HASH :: u64(0x11a076f3d5e9936d)

