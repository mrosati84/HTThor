// DETECT_MARKS is `ENCODING_MARKS` in dictionary order: the BOM/SIG table
// `identify_sig_or_bom` walks (tests/parity/README.md has the shapes).
Detect_Mark :: struct {
	name: string,
	mark: string,
}

DETECT_MARKS := []Detect_Mark{
	{name = "utf_8", mark = "\xef\xbb\xbf"},
	{name = "utf_7", mark = "+/v8"},
	{name = "utf_7", mark = "+/v9"},
	{name = "utf_7", mark = "+/v+"},
	{name = "utf_7", mark = "+/v/"},
	{name = "gb18030", mark = "\x841\x953"},
	{name = "utf_32", mark = "\x00\x00\xfe\xff"},
	{name = "utf_32", mark = "\xff\xfe\x00\x00"},
	{name = "utf_16", mark = "\xfe\xff"},
	{name = "utf_16", mark = "\xff\xfe"},
}

