// Detect_Port_Kind is whether the port can follow a candidate at all:
// `Single_Byte` decodes it with charset_generated.odin's table, `Utf8` with
// the utf-8 walk, `Unsupported` is a candidate the port has no decoder for
// (the reference's multi-byte and stateful code pages) — treated exactly as
// the reference treats a payload its decoder refuses.
Detect_Port_Kind :: enum u8 {
	Single_Byte,
	Utf8,
	Unsupported,
}

// Detect_Candidate is one code page of the loop's order
// (`IANA_SUPPORTED_MB_FIRST`: the multibyte ones first, IANA order inside
// each group — `api.py:38-47`).
Detect_Candidate :: struct {
	name:      string,
	multi_byte: bool,
	kind:      Detect_Port_Kind,
}

