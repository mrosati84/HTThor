// DETECT_LANGUAGES is `FREQUENCIES` (cd.py's language model): `chars` is
// the language's characters in popularity order, `count` its length (a
// repeated character counts twice — `characters_popularity_compare` uses
// the raw length), and DETECT_LANG_CP/RANK the distinct characters sorted
// by code point with their `_FREQUENCIES_RANK` (the last index wins).
Detect_Language :: struct {
	name:           string,
	chars:          string,
	count:          u16,
	have_accents:   bool,
	pure_latin:     bool,
	cp_start:       u32,
	cp_count:       u32,
}

